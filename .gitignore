# .gitignore di frontend/ dan backend/ tetap berlaku untuk folder masing-masing.

# Env & rahasia (semua folder)
.env
.env.*
!.env.example

# Cookie jar curl: bisa berisi token login
backend/cookie.txt

# Hasil export Excel (data bisnis asli, tidak dipakai test).
# backend/assets/ sengaja TIDAK di-ignore: test import Excel membaca file di sana.
backend/postman/*.xlsx

# Supabase CLI
supabase/.temp/

# OS / editor
.DS_Store
Thumbs.db
