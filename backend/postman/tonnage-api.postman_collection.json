              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Tarif baru berlaku mulai effectiveFrom. id disimpan ke variabel priceRateId."
          }
        },
        {
          "name": "Update (OWNER)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/v1/price-rates/{{priceRateId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pricePerKg\": 2750\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete (OWNER)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/v1/price-rates/{{priceRateId}}"
          }
        }
      ]
    },
    {
      "name": "Audit logs",
      "item": [
        {
          "name": "List (OWNER)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/audit-logs?page=1&limit=50"
          }
        },
        {
          "name": "List filtered (OWNER)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/audit-logs?entity=DailyRecap&action=update&from=2026-10-01&to=2026-10-31&page=1&limit=50",
            "description": "Filter opsional: from, to (inklusif), userId, entity, entityId, action, page, limit."
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/dashboard/summary?month={{month}}",
            "description": "Tanpa ?month = bulan berjalan."
          }
        },
        {
          "name": "Daily trend",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/dashboard/daily?month={{month}}"
          }
        },
        {
          "name": "Monthly trend",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/dashboard/monthly?to={{month}}&months=12"
          }
        }
      ]
    }
  ]
}
