generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  // Tanpa engine Rust (GA sejak Prisma 6.16): query lewat driver adapter @prisma/adapter-pg,
  // jadi tidak ada file engine native (.node) yang bisa tertinggal saat deploy ke Vercel Functions.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  VIEWER
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique
  name         String
  passwordHash String
  role         Role     @default(VIEWER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  auditLogs     AuditLog[]
  expenses      Expense[]
  discrepancies StockDiscrepancy[]
}

// Satu baris per tanggal, disalin dari TOTAL di PDF laporan harian staf.
// Ketiga nilai (total, export, local) selalu disimpan; yang tidak diketik admin dihitung server.
model DailyRecap {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date

  processTotal  Decimal @default(0) @db.Decimal(12, 2)
  processExport Decimal @default(0) @db.Decimal(12, 2)
  processLocal  Decimal @default(0) @db.Decimal(12, 2)

  packingTotal  Decimal @default(0) @db.Decimal(12, 2)
  packingExport Decimal @default(0) @db.Decimal(12, 2)
  packingLocal  Decimal @default(0) @db.Decimal(12, 2)

  // Sisa stok: posisi stok di hari itu, bukan aliran, jadi tidak dijumlah per bulan.
  stockTotal  Decimal @default(0) @db.Decimal(12, 2)
  stockExport Decimal @default(0) @db.Decimal(12, 2)
  stockLocal  Decimal @default(0) @db.Decimal(12, 2)

  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Harga per kg proses. Tarif berlaku mulai effectiveFrom sampai ada tarif berikutnya.
model PriceRate {
  id            String   @id @default(cuid())
  effectiveFrom DateTime @unique @db.Date
  pricePerKg    Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Pengeluaran per tanggal. Satu tanggal boleh punya banyak pengeluaran.
model Expense {
  id          String   @id @default(cuid())
  date        DateTime @db.Date
  category    String // teks bebas; ejaan disamakan dengan kategori yang sudah ada (lihat expense.service)
  amount      Int // rupiah
  note        String?
  createdById String   @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
}

// Bagian jurnal harian. OUT = barang keluar (diisi manual, tahap berikutnya).
enum JournalSection {
  PROCESS
  PACKING
  STOCK
  OUT
}

enum Market {
  EXPORT
  LOCAL
}

// Satu baris jurnal harian, disalin apa adanya dari laporan staf (tanpa perhitungan
// atau penyeragaman nama). Label pasar disimpan per baris supaya data lama tidak berubah
// kalau label supplier diganti belakangan.
model JournalEntry {
  id       String         @id @default(cuid())
  date     DateTime       @db.Date
  section  JournalSection
  party    String // supplier (proses/packing/sisa) atau pelanggan (keluar), teks bebas
  item     String // jenis ikan
  size     String?
  mc       Decimal?       @db.Decimal(12, 2)
  kg       Decimal        @db.Decimal(12, 2)
  market   Market
  position Int // urutan baris seperti di laporan

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date, section])
}

enum DiscrepancyCause {
  MISCOUNT // salah hitung
  DAMAGE // rusak / susut
  OUT_UNRECORDED // barang keluar belum dicatat
  OTHER
}

enum DiscrepancyStatus {
  OPEN
  RESOLVED
}

// Catatan selisih stok yang ditemukan staf, diisi manual. Hanya catatan: tidak mengubah angka jurnal.
// Barang diketik bebas (pemilik, jenis, size), sama seperti laporan staf.
model StockDiscrepancy {
  id         String            @id @default(cuid())
  date       DateTime          @db.Date
  party      String
  item       String
  size       String?
  mcDiff     Decimal?          @db.Decimal(12, 2) // + lebih banyak dari catatan, - kurang
  kgDiff     Decimal?          @db.Decimal(12, 2)
  cause      DiscrepancyCause
  note       String?
  status     DiscrepancyStatus @default(OPEN)
  resolution String? // keterangan penyelesaian saat ditandai selesai
  resolvedAt DateTime?

  createdById String   @db.Uuid
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([status])
}

// Label pasar terakhir per nama supplier, untuk mengisi otomatis pratinjau import berikutnya.
// Kunci = nama persis seperti di laporan (dirapikan spasinya saja).
model SupplierMarket {
  name      String   @id
  market    Market
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  action    String // create | update | delete | import
  entity    String // DailyRecap | PriceRate | Expense | Journal | JournalEntry | StockDiscrepancy
  entityId  String?
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([userId])
}
